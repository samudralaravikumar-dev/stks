# Copy this file to secrets.toml (same folder) and fill in your Kite Connect app credentials
# from https://developers.kite.trade/apps . Never share or commit secrets.toml.
# In the Kite app settings, set the Redirect URL to:  http://localhost:8502/

# Upstox: create an app at https://account.upstox.com/developer/apps with the same Redirect URL
[upstox]
api_key = "your_upstox_api_key"
api_secret = "your_upstox_api_secret"
redirect_uri = "http://localhost:8502/"

[kite]
api_key = "your_api_key"
api_secret = "your_api_secret"

# SMS OTP login. provider = "twilio" | "msg91" | "fast2sms" | "console" (testing: OTP printed in server window)
#   twilio   : Twilio Verify service; works in India without your own DLT registration
#   msg91    : needs DLT-approved OTP template (template_id) + authkey
#   fast2sms : "OTP" route API key (website verification needed in their dashboard)
[sms]
provider = "console"
twilio_sid = "ACxxxxxxxx"
twilio_token = "your_auth_token"
twilio_verify_sid = "VAxxxxxxxx"
msg91_authkey = ""
msg91_template_id = ""
fast2sms_key = ""

# Telegram alerts: create a bot with @BotFather, message it once, then read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
[telegram]
bot_token = "123456:ABC-your-bot-token"
chat_id = "123456789"
